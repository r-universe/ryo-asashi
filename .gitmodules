[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "colortheme"]
	path = colortheme
	url = https://github.com/ryo-asashi/colortheme
[submodule "midnight"]
	path = midnight
	url = https://github.com/ryo-asashi/midnight
[submodule "midr"]
	path = midr
	url = https://github.com/ryo-asashi/midr
